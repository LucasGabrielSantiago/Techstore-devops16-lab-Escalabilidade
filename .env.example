# ==========================================
# TechStore - configuração do ambiente (Docker Compose)
# Copie para .env:  cp .env.example .env
# ==========================================

# Porta pública (Nginx). 8080 evita conflito com outro serviço na porta 80.
HTTP_PORT=8080

# Número INICIAL de réplicas da API (pode ser alterado com --scale)
APP_REPLICAS=2

# Imagem da API. Local: techstore-api:local
# Docker Hub:  <seu-usuario>/techstore-api:latest
APP_IMAGE=techstore-api:local

# Limites por réplica (simulam servidores pequenos e deixam o ganho da escala mensurável)
APP_CPU_LIMIT=0.5
APP_MEM_LIMIT=256M

# PostgreSQL
DB_USER=techstore
DB_PASSWORD=troque-esta-senha
DB_NAME=techstore
DB_POOL_MAX=10

# Autenticação (JWT)
# A MESMA chave em todas as réplicas: qualquer réplica valida o token gerado por outra.
# Gere uma chave longa e aleatória, por exemplo:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-esta-chave-por-uma-longa-e-aleatoria
JWT_EXPIRES_IN=2h
