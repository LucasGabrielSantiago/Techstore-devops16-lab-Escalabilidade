# ==========================================
# TechStore API - Variáveis de ambiente
# (execução SEM Docker; com Docker, use o .env da raiz)
# ==========================================

# Porta utilizada pela aplicação
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=techstore
DB_PASSWORD=techstore
DB_NAME=techstore
DB_POOL_MAX=10

# Autenticação (JWT) - a mesma chave em todas as réplicas
JWT_SECRET=troque-esta-chave-por-uma-longa-e-aleatoria
JWT_EXPIRES_IN=2h
